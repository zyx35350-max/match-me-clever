# Browser-side Supabase configuration (publishable key only; never use a service-role key here).
# These are optional if you intentionally use the fallback project configured in src/lib/supabase.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Never commit a real key.
GEMINI_API_KEY=
# Optional; defaults to the configured Gemini Flash model.
GEMINI_MODEL=gemini-3.8-flash
